//7. Отсортированные числа в порядке возрастания и убывания.

void main() {
    System.out.print("Напишите сколько числе вы хотите ввести ");
    Scanner scan = new Scanner(System.in);
    int x = scan.nextInt();
    int[] mas = new int[x];
    System.out.println("ВВедите элементы масива ");
    for (int i = 0 ; i < x; i++) {
        mas[i] = scan.nextInt();
    }
    System.out.println("Сортировать по убыванию(1) или возрастанию(2) введите число; ");
    int us = scan.nextInt();
    if (us ==2 ){
        for (int i = 0; i < x - 1; i++ ) {
            for (int r = 0; r < x -1 -i; r++){
                if(mas[r] > mas[r + 1]) {
                    int z = mas[r];
                    mas[r] =mas[r + 1];
                    mas[r + 1] = z;
                }
            }

        }
    }
    else{
        for (int i = 0; i < x - 1; i++ ) {
            for (int r = 0; r < x -1 -i; r++){
                if(mas[r] < mas[r + 1]) {
                    int z = mas[r];
                    mas[r] =mas[r + 1];
                    mas[r + 1] = z;
                }
            }

        }
    }
    for (int el : mas) {
        System.out.print(el + "");
    }
}
